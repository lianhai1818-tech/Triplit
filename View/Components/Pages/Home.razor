@page "/"

<PageTitle>דף הבית - Triplit</PageTitle>

<!-- אזור הפתיחה (Hero Section) -->
<section class="py-5 bg-light border-bottom">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge mb-3 px-3 py-2" style="background-color: #ffb6c1; color: #d63384; font-size: 0.9rem;">מערכת תכנון טיולים מתקדמת</span>
                <h1 class="display-4 fw-bold mb-3">תכנן את הטיול המושלם הבא שלך בקלות</h1>
                <p class="lead text-secondary mb-4">
                    עם Triplit תוכל לנהל מסלולים יומיים, לעקוב אחר הוצאות בזמן אמת, להיעזר במרכזי חירום ולשתף חוויות עם חברים במקום אחד.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/register" class="btn fw-bold text-white border-0 btn-lg px-4" style="background-color: #ffb6c1;">התחל בחינם</a>
                    <a href="/login" class="btn fw-bold btn-lg px-4" style="border: 2px solid #ffb6c1; color: #d63384;">כניסה לחשבון</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <!-- תמונה אמיתית מתוך תיקיית images -->
                    <img src="images/travel1.jpg" alt="תכנון טיול" class="img-fluid rounded-3 mb-3 shadow-sm" style="max-height: 260px; object-fit: cover; width: 100%;" />
                    <h5 class="fw-bold">הטיולים שלך, בכל מקום</h5>
                    <p class="text-secondary small mb-0">הכל מסונכרן, ממוספר ונגיש מכל מכשיר.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- אזור היתרונות (למה לבחור ב-Triplit) -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">למה לתכנן עם Triplit?</h2>
            <p class="text-secondary">הכלים המתקדמים ביותר להרפתקה הבאה שלך</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3" style="color: #38b6ff;">01</h4>
                    <h5 class="fw-bold">מסלולים יומיים</h5>
                    <p class="text-secondary mb-0">בנה לוח זמנים מפורט לכל יום בטיול, שלב אטרקציות וניהול זמנים חכם.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3" style="color: #38b6ff;">02</h4>
                    <h5 class="fw-bold">מעקב הוצאות</h5>
                    <p class="text-secondary mb-0">שלטו בתקציב המשפחתי או הקבוצתי ותעדו כל הוצאה בקלות בזמן אמת.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h4 class="fw-bold mb-3" style="color: #38b6ff;">03</h4>
                    <h5 class="fw-bold">מרכז חירום ושיתוף</h5>
                    <p class="text-secondary mb-0">גישה מהירה למספרי חירום ביעד ושותפות מלאה עם חברי הקבוצה.</p>
                </div>
            </div>
        </div>
    </div>
</section>